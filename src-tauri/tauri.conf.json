{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchEQ",
  "version": "0.1.0",
  "identifier": "it.switcheq.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SwitchEQ",
        "width": 1040,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "visible": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Equalizzatore per cuffie con correzioni AutoEq",
    "longDescription": "Equalizzazione per qualsiasi cuffia (correzioni AutoEq tramite Equalizer APO), stato Bluetooth, batteria e preset automatici per app e giochi.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["English", "Italian"],
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
